# Target environment: local | dev | staging | prod
TARGET_ENV=dev

# Optional runtime override for target base URL
# BASE_URL=https://dev-api.example.com

# Load profile: smoke | load | stress | soak
LOAD_PROFILE=smoke

# Optional request timeout (k6 duration format)
# REQUEST_TIMEOUT=30s

# Authentication configuration: none | bearer | apikey | oauth2
AUTH_TYPE=none

# Bearer token auth (when AUTH_TYPE=bearer)
# AUTH_TOKEN=your-bearer-token

# API Key auth (when AUTH_TYPE=apikey)
# API_KEY=your-api-key
# API_KEY_HEADER=X-API-Key

# OAuth2 Client Credentials (when AUTH_TYPE=oauth2)
# OAUTH_TOKEN_URL=https://auth.example.com/oauth/token
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_SCOPE=read write

# Optional Prometheus Remote Write (used when running k6 with -o experimental-prometheus-rw)
# K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
# K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM=true
